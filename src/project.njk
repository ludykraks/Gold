---
layout: layouts/studio.html
portfolio: true
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/work/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.name }} Case Study | GoldChest Technologies"
  description: "{{ project.summary }}"
---
<article class="case-study">
  <header class="case-hero shell">
    <a class="portfolio-link case-back" href="/work/"><span aria-hidden="true">←</span> All work</a>
    <p class="eyebrow">{{ project.name | escape }} / Case study</p>
    <h1>{{ project.headline | escape }}</h1>
    <p class="case-lead">{{ project.summary | escape }}</p>
    <dl class="case-facts"><div><dt>Client</dt><dd>{{ project.name | escape }}</dd></div><div><dt>Sector</dt><dd>{{ project.sector | escape }}</dd></div><div><dt>Our role</dt><dd>{{ project.service | escape }}</dd></div></dl>
  </header>
  <div class="case-visual {{ project.slug }}"><div class="shell"><img src="/images/work/{{ project.slug }}-desktop.jpg" alt="{{ project.name | escape }} homepage on desktop" width="{{ project.desktopWidth or 1425 }}" height="{{ project.desktopHeight or 926 }}" fetchpriority="high" decoding="async"></div></div>
  <div class="case-paper">
    <div class="shell case-body">
      <nav class="case-nav" aria-label="Case study sections"><p class="portfolio-meta">Inside the project</p><a href="#challenge">01 / The challenge</a><a href="#approach">02 / Our approach</a><a href="#delivered">03 / What we delivered</a><a href="{{ project.url | escape }}" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span><span class="case-sr"> (opens in a new tab)</span></a>{% if project.socialUrl %}<a href="{{ project.socialUrl | escape }}" target="_blank" rel="noopener noreferrer">View Instagram <span aria-hidden="true">↗</span><span class="case-sr"> (opens in a new tab)</span></a>{% endif %}</nav>
      <div class="case-story">
        <section id="challenge"><p class="portfolio-meta">01 / The challenge</p><h2>{{ project.challengeTitle | escape }}</h2><p>{{ project.challenge | escape }}</p></section>
        <section id="approach"><p class="portfolio-meta">02 / Our approach</p><h2>{{ project.approachTitle | escape }}</h2>{% for paragraph in project.approach %}<p>{{ paragraph | escape }}</p>{% endfor %}
        {% if project.platforms %}<ol class="case-platforms">{% for platform in project.platforms %}<li><span>{{ platform.name | escape }}</span><p>{{ platform.role | escape }}</p></li>{% endfor %}</ol>{% endif %}
        </section>
      </div>
    </div>
    <section class="case-mobile shell" aria-labelledby="mobile-title">
      <div class="case-phone {{ project.slug }}"><img src="/images/work/{{ project.slug }}-mobile.jpg" alt="{{ project.name | escape }} website at a mobile screen size" width="{{ project.mobileWidth or 375 }}" height="{{ project.mobileHeight or 812 }}" loading="lazy" decoding="async"></div>
      <div><p class="portfolio-meta">A closer look</p><h2 id="mobile-title">{{ project.detailTitle | escape }}</h2><p>{{ project.detail | escape }}</p><p class="case-caption">Desktop and mobile views of the project website.</p></div>
    </section>
    <section class="case-delivered shell" id="delivered" aria-labelledby="delivered-title"><p class="portfolio-meta">03 / What we delivered</p><h2 id="delivered-title">{{ project.deliveredTitle | escape }}</h2><div class="case-deliverables{% if project.deliverables.length == 4 %} case-deliverables-four{% endif %}">{% for item in project.deliverables %}<div><span class="case-number">0{{ loop.index }}</span><h3>{{ item.title | escape }}</h3><p>{{ item.text | escape }}</p></div>{% endfor %}</div></section>
  </div>
</article>
{% include "partials/portfolio-cta.njk" %}
<section class="case-more shell" aria-labelledby="more-title"><p class="eyebrow">Keep exploring</p><h2 id="more-title">More work. More possibilities.</h2><div>{% for other in projects %}{% if other.slug != project.slug %}<a href="/work/{{ other.slug }}/"><span>{{ other.name | escape }}</span><strong>{{ other.headline | escape }}</strong><span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}</div></section>
