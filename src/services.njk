---
layout: layouts/studio.html
permalink: /services/index.html
eleventyComputed:
title: "{{ servicesPage.title }}"
description: "{{ servicesPage.description }}"
---
{# Edit page wording in src/_data/servicesPage.json. #}
{% macro headingLines(lines) -%}
{% for line in lines %}{{ line | escape }}{% if not loop.last %}<br>{% endif %}{% endfor %}
{%- endmacro %}

<section class="page-hero shell">
  <p class="eyebrow">{{ servicesPage.hero.label | escape }}</p>
  <h1>{{ headingLines(servicesPage.hero.heading) }}</h1>
  <p>{{ servicesPage.hero.description | escape }}</p>
  <a class="button" href="{{ servicesPage.hero.link.url | escape }}">{{ servicesPage.hero.link.text | escape }}</a>
</section>

<div class="light-section">
  {% for service in servicesPage.services %}
  <section id="{{ service.id | escape }}" class="shell detail-section">
    <div>
      <h2 class="eyebrow">{{ service.label | escape }}</h2>
      <p>{{ headingLines(service.heading) }}</p>
    </div>
    <div>
      {% for block in service.content %}
      {% if block.heading %}<h3>{{ block.heading | escape }}</h3>{% endif %}
      {% if block.text %}<p>{{ block.text | escape }}</p>{% endif %}
      {% if block.bullets %}
      <ul>
        {% for bullet in block.bullets %}
        <li>{{ bullet | escape }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endfor %}
      <a class="text-link" href="{{ service.link.url | escape }}">{{ service.link.text | escape }}</a>
    </div>
  </section>
  {% endfor %}
</div>

<section class="shell closing-section">
  <h2>{{ servicesPage.closing.heading | escape }}</h2>
  <p>{{ servicesPage.closing.description | escape }}</p>
  <a class="button"
    href="{{ servicesPage.closing.link.url | escape }}">{{ servicesPage.closing.link.text | escape }}</a>
</section>