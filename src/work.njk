---
layout: layouts/studio.html
title: Our Work | GoldChest Technologies
description: Explore the websites, booking experiences and online stores we have built for KraftGurus, Cheezzy Pizza and Frantomapa.
permalink: /work/index.html
portfolio: true
---
<section class="portfolio-hero shell">
  <p class="eyebrow">Selected work / GoldChest</p>
  <h1>Different businesses.<br><span>The same care.</span></h1>
  <div class="portfolio-intro"><p>From ordering a favourite pizza to booking an art workshop. We build websites around what your customers come to do.</p><a class="portfolio-link" href="#projects">Explore the work <span aria-hidden="true">↓</span></a></div>
</section>
<section class="portfolio-work" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <div class="portfolio-section-label"><h2 id="projects-title">The work, up close</h2><span>01 — 03</span></div>
    <div class="portfolio-grid">
    {% for project in projects %}
      <article class="portfolio-card{% if loop.first %} portfolio-featured{% endif %}">
        <a class="portfolio-cover {{ project.slug }}" href="/work/{{ project.slug }}/" aria-label="View {{ project.name | escape }} case study">
          <img src="/images/work/{{ project.slug }}-desktop.jpg" alt="{{ project.name | escape }} website on desktop" width="1440" height="1000" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
          <span class="portfolio-open" aria-hidden="true">↗</span>
        </a>
        <div class="portfolio-card-copy">
          <p class="portfolio-meta">{% if loop.first %}Featured project <span aria-hidden="true">/</span> {% endif %}{{ project.category | escape }}</p>
          <p class="portfolio-client">{{ project.name | escape }}</p>
          <h3><a href="/work/{{ project.slug }}/">{{ project.headline | escape }}</a></h3>
          <p>{{ project.summary | escape }}</p>
          <a class="portfolio-link" href="/work/{{ project.slug }}/">Explore {{ project.shortName | escape }} <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    {% endfor %}
    </div>
  </div>
</section>
{% include "partials/portfolio-cta.njk" %}
